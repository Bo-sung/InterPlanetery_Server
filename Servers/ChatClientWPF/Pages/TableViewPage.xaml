<Page x:Class="ChatClientWPF.Pages.TableViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Style="{StaticResource PageStyle}"
      Title="Table Viewer">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 테이블 리스트 -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <TextBlock Grid.Row="0"
                           Text="Database Tables"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <!-- 새로고침 버튼 -->
                <Button Grid.Row="1"
                        x:Name="RefreshButton"
                        Content="Refresh Tables"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,0,15"
                        Click="RefreshButton_Click"/>

                <!-- 테이블 리스트 -->
                <ListBox Grid.Row="2"
                         x:Name="TableListBox"
                         Style="{StaticResource ListBoxStyle}"
                         ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                         SelectionChanged="TableListBox_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"/>

        <!-- 우측: 테이블 데이터 뷰 -->
        <Border Grid.Column="2"
                Background="{StaticResource BackgroundBrush}"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 선택된 테이블 이름 -->
                <TextBlock Grid.Row="0"
                           x:Name="SelectedTableText"
                           Text="Select a table from the list"
                           Style="{StaticResource PageHeaderStyle}"/>

                <!-- 레코드 개수 -->
                <TextBlock Grid.Row="1"
                           x:Name="RecordCountText"
                           Text=""
                           Style="{StaticResource TextSecondaryStyle}"
                           Margin="0,0,0,15"/>

                <!-- 데이터 그리드 -->
                <DataGrid Grid.Row="2"
                          x:Name="TableDataGrid"
                          Style="{StaticResource DataGridStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
