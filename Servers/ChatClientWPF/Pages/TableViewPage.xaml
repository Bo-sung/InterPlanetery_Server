<Page x:Class="ChatClientWPF.Pages.TableViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Table Viewer"
      Background="#FF1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 테이블 리스트 -->
        <Border Grid.Column="0"
                Background="#FF252526"
                BorderBrush="#FF3E3E42"
                BorderThickness="0,0,1,0"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <TextBlock Grid.Row="0"
                           Text="Database Tables"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <!-- 새로고침 버튼 -->
                <Button Grid.Row="1"
                        x:Name="RefreshButton"
                        Content="Refresh Tables"
                        Padding="10,5"
                        Margin="0,0,0,10"
                        Background="#FF007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="RefreshButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF007ACC"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1E90DA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 테이블 리스트 -->
                <ListBox Grid.Row="2"
                         x:Name="TableListBox"
                         Background="#FF2D2D30"
                         Foreground="White"
                         BorderThickness="0"
                         SelectionChanged="TableListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF007ACC"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF3E3E42"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="#FF3E3E42"/>

        <!-- 우측: 테이블 데이터 뷰 -->
        <Border Grid.Column="2"
                Background="#FF1E1E1E"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 선택된 테이블 이름 -->
                <TextBlock Grid.Row="0"
                           x:Name="SelectedTableText"
                           Text="Select a table from the list"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <!-- 레코드 개수 -->
                <TextBlock Grid.Row="1"
                           x:Name="RecordCountText"
                           Text=""
                           FontSize="12"
                           Foreground="#FFAAAAAA"
                           Margin="0,0,0,10"/>

                <!-- 데이터 그리드 -->
                <DataGrid Grid.Row="2"
                          x:Name="TableDataGrid"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          Background="#FF252526"
                          RowBackground="#FF2D2D30"
                          AlternatingRowBackground="#FF333337"
                          GridLinesVisibility="All"
                          BorderBrush="#FF3E3E42"
                          BorderThickness="1"
                          Foreground="White"
                          HeadersVisibility="Column"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FF007ACC"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="#FF005A9E"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="BorderBrush" Value="#FF3E3E42"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF264F78"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
