<Page x:Class="ChatClientWPF.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Style="{StaticResource PageStyle}"
      Title="Chat Test Page">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 연결 섹션 -->
        <Border Grid.Row="0" Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Server Connection" Style="{StaticResource SectionHeaderStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Host:" Style="{StaticResource LabelStyle}" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="HostTextBox" Text="127.0.0.1" Style="{StaticResource TextBoxStyle}"/>

                    <TextBlock Grid.Column="2" Text="Port:" Style="{StaticResource LabelStyle}" Margin="20,0,10,0"/>
                    <TextBox Grid.Column="3" x:Name="PortTextBox" Text="7777" Style="{StaticResource TextBoxStyle}"/>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="ConnectButton_Click"/>
                        <Button x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource SecondaryButtonStyle}" Click="DisconnectButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 상태 바 -->
        <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Connection:" Style="{StaticResource SubHeaderStyle}" Margin="0"/>
                <TextBlock Grid.Column="1" x:Name="ConnectionStatusText" Text="Disconnected" Style="{StaticResource TextPrimaryStyle}" Foreground="#FFDC143C" Margin="10,0,0,0"/>

                <TextBlock Grid.Column="2" Text="User ID:" Style="{StaticResource SubHeaderStyle}" Margin="20,0,10,0"/>
                <TextBlock Grid.Column="3" x:Name="UserIdText" Text="-" Style="{StaticResource TextSecondaryStyle}"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="JoinRoomButton" Content="Join Room" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="JoinRoomButton_Click" IsEnabled="False"/>
                    <Button x:Name="LeaveRoomButton" Content="Leave Room" Style="{StaticResource WarningButtonStyle}" Click="LeaveRoomButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 채팅 영역 -->
        <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Chat Room" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- 룸 정보 -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceHoverBrush}" Padding="10" CornerRadius="3" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Room:" Style="{StaticResource SubHeaderStyle}" Margin="0"/>
                        <TextBlock x:Name="RoomIdText" Text="Not in room" Style="{StaticResource TextSecondaryStyle}" Margin="10,0,0,0"/>
                        <TextBlock Text="Players:" Style="{StaticResource SubHeaderStyle}" Margin="30,0,10,0"/>
                        <TextBlock x:Name="PlayerCountText" Text="0" Style="{StaticResource TextSecondaryStyle}"/>
                    </StackPanel>
                </Border>

                <!-- 메시지 리스트 -->
                <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="10">
                        <ItemsControl x:Name="ChatMessagesPanel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="5,3" Margin="0,2">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- 입력 영역 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="MessageTextBox"
                     Style="{StaticResource TextBoxStyle}"
                     IsEnabled="False" KeyDown="MessageTextBox_KeyDown"/>
            <Button Grid.Column="1" x:Name="SendButton" Content="Send"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="10,0,0,0" Click="SendButton_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Page>
