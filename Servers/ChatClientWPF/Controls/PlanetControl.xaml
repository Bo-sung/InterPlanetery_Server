<UserControl x:Class="ChatClientWPF.Controls.PlanetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- 행성을 중앙에 배치하는 컨테이너 -->
    <StackPanel x:Name="RootPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <!-- 행성 원 -->
        <Grid x:Name="PlanetGrid"
              HorizontalAlignment="Center">
            <Ellipse x:Name="PlanetEllipse"
                     Fill="White"
                     Stroke="LightGray"
                     StrokeThickness="1"
                     Cursor="Hand"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="GlowEffect"
                                      BlurRadius="0"
                                      ShadowDepth="0"
                                      Opacity="0"/>
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!-- 행성 이름 텍스트 -->
        <TextBlock x:Name="PlanetNameText"
                   Foreground="White"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   IsHitTestVisible="False"
                   Margin="0,3,0,2"/>

        <!-- 자원 정보 패널 (행성 아래) -->
        <StackPanel x:Name="ResourcePanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Opacity="0.85"
                    IsHitTestVisible="False">

            <!-- Gas (초록색 배경) -->
            <Border Background="#FF2E7D32"
                    CornerRadius="3"
                    Padding="4,2"
                    Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="G:"
                               Foreground="White"
                               FontSize="8"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="GasText"
                               Text="0"
                               Foreground="White"
                               FontSize="8"
                               Margin="2,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Mineral (파란색 배경) -->
            <Border Background="#FF1565C0"
                    CornerRadius="3"
                    Padding="4,2"
                    Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="M:"
                               Foreground="White"
                               FontSize="8"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="MineralText"
                               Text="0"
                               Foreground="White"
                               FontSize="8"
                               Margin="2,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Supply (주황색 배경) -->
            <Border Background="#FFE65100"
                    CornerRadius="3"
                    Padding="4,2"
                    Margin="1,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="S:"
                               Foreground="White"
                               FontSize="8"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="SupplyText"
                               Text="0"
                               Foreground="White"
                               FontSize="8"
                               Margin="2,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
