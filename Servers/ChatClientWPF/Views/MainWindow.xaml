<Window x:Class="ChatClientWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:ChatClientWPF.Pages"
        mc:Ignorable="d"
        Title="InterPlanetery Test Tool" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- TabControl로 여러 테스트 페이지 관리 -->
        <TabControl Margin="10">
            <!-- Chat Test 탭 -->
            <TabItem Header="Chat Test">
                <Frame x:Name="ChatFrame" NavigationUIVisibility="Hidden">
                    <Frame.Content>
                        <pages:ChatPage/>
                    </Frame.Content>
                </Frame>
            </TabItem>

            <!-- 추가 테스트 탭 (향후 확장용) -->
            <TabItem Header="Performance Test">
                <Grid>
                    <TextBlock Text="Performance Test Page (Coming Soon...)"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>

            <TabItem Header="Stress Test">
                <Grid>
                    <TextBlock Text="Stress Test Page (Coming Soon...)"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="Gray"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
